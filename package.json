  "description": "MCP server that lets Claude drive a real browser and turn what it does into a Clikta interactive demo, step guide, and narrated video — automatically.",
  "keywords": ["mcp", "model-context-protocol", "claude", "browser-automation", "playwright", "documentation", "demo"],
  "license": "MIT",
  "author": "Clikta, Lda.",
  "homepage": "https://clikta.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rscoelho/clikta-mcp-server.git"
  },
  "bugs": "https://github.com/rscoelho/clikta-mcp-server/issues",
  "type": "module",
  "bin": {
    "clikta-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
