# Base URL of your Clikta workspace
CLIKTA_API_URL="https://clikta.com"

# Generate in the Clikta web app: Settings -> API Token
CLIKTA_API_TOKEN="clikta_..."

# "true" to run Chromium headless (CI/scripted use). Defaults to headed so
# you can watch Claude drive the demo live.
CLIKTA_MCP_HEADLESS="false"
